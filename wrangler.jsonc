{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beatonstep-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-11",
  "build": {
    "command": "node scripts/build-static.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/partages.html",
      "/cadeau",
      "/cadeau/"
    ]
  },
  "vars": {
    "CATALOG_BACKEND": "d1",
    "COMMUNITY_SIGNUPS_ENABLED": "true",
    "CARDS_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beatonstep-catalog-prod",
      "database_id": "278e152c-3338-4e0d-adfd-673eac7c60cb",
      "migrations_dir": "migrations"
    }
  ]
}
