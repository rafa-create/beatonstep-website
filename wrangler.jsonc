{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beatonstep-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "CATALOG_BACKEND": "legacy"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beatonstep-catalog-prod",
      "database_id": "8ebb0348-c3b6-41f1-a2e9-54c88643fdd1",
      "migrations_dir": "migrations"
    }
  ]
}
