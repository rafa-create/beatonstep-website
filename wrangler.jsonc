{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beatonstep-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-11",
  "build": {
    "command": "node scripts/build-static.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/partages.html",
      "/cadeau",
      "/cadeau/"
    ]
  },
  "vars": {
    "CATALOG_BACKEND": "d1",
    "COMMUNITY_SIGNUPS_ENABLED": "true",
    "CARDS_ENABLED": "true",
    "DISTANCE_CHALLENGES_ENABLED": "false",
    "PASSWORD_RESET_EMAIL_FROM": "no-reply@beatonstep.app",
    "STRAVA_CLIENT_ID": "178799",
    "STRAVA_ATHLETE_CAPACITY": "10",
    "STRAVA_EXPORT_ENABLED": "true",
    "SPORT_WORLD_CARDS_ENABLED": "true",
    "SPORT_WORLD_GIFTS_ENABLED": "true",
    "SPORT_AUTO_AWARDS_ENABLED": "true",
    "SPORT_ASYNC_TELEMETRY_ENABLED": "false"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beatonstep-catalog-prod",
      "database_id": "278e152c-3338-4e0d-adfd-673eac7c60cb",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "vars": {
      "CATALOG_BACKEND": "d1",
      "COMMUNITY_SIGNUPS_ENABLED": "false",
      "CARDS_ENABLED": "false",
      "DISTANCE_CHALLENGES_ENABLED": "false",
      "SPORT_WORLD_CARDS_ENABLED": "false",
      "SPORT_WORLD_GIFTS_ENABLED": "false",
      "SPORT_AUTO_AWARDS_ENABLED": "false",
      "SPORT_ASYNC_TELEMETRY_ENABLED": "false"
    }
  }
}
