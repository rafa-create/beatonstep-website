{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beatonstep-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CATALOG_BACKEND": "legacy"
  },
  "observability": { "enabled": true }
}
